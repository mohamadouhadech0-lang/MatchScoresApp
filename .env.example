# apifootball.com v3 key (https://apifootball.com/dashboard/). Empty → mock data.
EXPO_PUBLIC_API_FOOTBALL_KEY=

# Copy to .env.local and fill in. These are public OAuth client IDs (not secrets).
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# true → always use the local demo data (ignores the key above).
EXPO_PUBLIC_USE_MOCK_DATA=
